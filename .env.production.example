# 프로덕션 환경 설정 (.env.production)
# 이 파일을 복사해서 .env.production 으로 만들고 실제 값을 채우세요.
# flutter build apk --dart-define=FLUTTER_ENV=production

# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# AdMob - 프로덕션 (실제 AdMob 콘솔 Ad Unit ID)
ADMOB_ANDROID_BANNER_ID=ca-app-pub-7521798484796470/9013949305
ADMOB_ANDROID_INTERSTITIAL_ID=ca-app-pub-7521798484796470/1135024515
ADMOB_IOS_BANNER_ID=YOUR_IOS_BANNER_AD_UNIT_ID
ADMOB_IOS_INTERSTITIAL_ID=YOUR_IOS_INTERSTITIAL_AD_UNIT_ID

# Apple App Store Connect > General > App Information > Apple ID
APP_STORE_ID=YOUR_APP_STORE_ID
