# 개발 환경 설정 (.env.development)
# 이 파일을 복사해서 .env.development 로 만들고 실제 값을 채우세요.
# flutter run --dart-define=FLUTTER_ENV=development

# Supabase
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

